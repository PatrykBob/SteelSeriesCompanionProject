<Project>
  <PropertyGroup>
    <CompanionExtensionDir>$(MSBuildThisFileDirectory)CoreApp\bin\$(Configuration)\net10.0-windows10.0.19041.0\Extension\</CompanionExtensionDir>
  </PropertyGroup>

  <Target Name="CopyToCompanionExtensionFolder"
          AfterTargets="Build"
          Condition="$(MSBuildProjectName.StartsWith('SteelSeriesSonarCompanion.Extension.'))">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(CompanionExtensionDir)"
          SkipUnchangedFiles="true"
          Retries="0"
          ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="Copied $(TargetFileName) to $(CompanionExtensionDir)" />
  </Target>
</Project>
