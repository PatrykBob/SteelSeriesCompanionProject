<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.ExtensionCore\SteelSeriesSonarCompanion.Shared.ExtensionCore.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- HACK: The plain lib/ copy of System.IO.Ports is a stub that throws PlatformNotSupportedException, so embed runtimes/win instead -->
  <Target Name="EmbedPackageAssemblies" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <EmbeddedResource Include="@(RuntimeTargetsCopyLocalItems)"
                        Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'System.IO.Ports'
                                   and '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' == 'win'
                                   and '%(RuntimeTargetsCopyLocalItems.AssetType)' == 'runtime'"
                        LogicalName="%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

</Project>
