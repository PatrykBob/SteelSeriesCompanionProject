<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SteelSeriesSonarCompanion.External.App.MainPage">
    <Grid
        RowDefinitions="*, Auto">
        <ContentView
            x:Name="PanelRoot"
            Grid.Row="0"/>
        <Grid
            Grid.Row="1"
            Padding="20"
            ColumnDefinitions="*, Auto">
            <Label
                x:Name="ConnectionLabel"
                Text="Not connected"
                VerticalOptions="Center"/>
            <Button
                x:Name="DoneEditingButton"
                Grid.Column="1"
                Text="Done"
                IsVisible="False"
                Clicked="OnDoneEditingClicked"/>
        </Grid>
    </Grid>
</ContentPage>
